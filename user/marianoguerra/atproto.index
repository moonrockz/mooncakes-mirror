{"name": "marianoguerra/atproto", "version": "0.1.0", "readme": "README.mbt.md", "repository": "https://github.com/marianoguerra/atproto-mb", "license": "Apache-2.0", "keywords": ["atproto", "bluesky", "xrpc", "lexicon", "client", "did"], "preferred_target": "wasm", "description": "AT Protocol (Bluesky) client: typed Lexicon records and responses, the atproto data model, XRPC, app-password sessions, and validators for DID, handle, NSID, AT-URI, TID and record keys. No dependencies; runs on every backend.", "checksum": "5036a3f8873a5f297e87c7cf0be248f5d061bf0ab3faf80b022d0f5309de1c99", "created_at": "2026-08-11T16:27:26.457544+00:00"}
